# Trusted editorial relay. No Docker socket, Caddy mount, customer secrets or
# ability to certify GitHub releases / unpause customer deployment workers.
FROM node:22-alpine
WORKDIR /runner
RUN printf '%s\n' '{"name":"hi5central-dev-release-relay","private":true,"type":"module","dependencies":{"pg":"8.23.0"}}' > package.json \
 && npm install --omit=dev --ignore-scripts --no-fund --no-audit \
 && addgroup -S relay && adduser -S relay -G relay
COPY services/api/src/releasePublicationRelay.mjs ./releasePublicationRelay.mjs
COPY services/api/src/releasePublicationRelayDaemon.mjs ./releasePublicationRelayDaemon.mjs
RUN node --check releasePublicationRelay.mjs \
 && node --check releasePublicationRelayDaemon.mjs
USER relay
ENTRYPOINT ["node","releasePublicationRelayDaemon.mjs"]
