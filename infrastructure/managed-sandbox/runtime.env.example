# DOCUMENTATION ONLY. DO NOT DEPLOY, AND NEVER PUT REAL CREDENTIALS IN GIT.
# Copy into two separate secure directories and replace EVERY placeholder.
# Required: chmod 600 runtime.env; change uat to test for second environment.
COMPOSE_PROJECT_NAME=hi5-sandbox-uat
EDGE_NETWORK=hi5central-sandbox-uat-edge
DEPLOYMENT_MODE=managed
TENANCY_MODE=multi
RUNTIME_ENVIRONMENT=uat
ROOT_DOMAIN=hi5central.com
FEATURE_MODE=controlled
BACKGROUND_WORKERS_ENABLED=false
COOKIE_DOMAIN=
PRIMARY_TENANT_SLUG=
APP_URL=
PORTAL_URL=
RMM_URL=
ADMIN_URL=
# Parallel pilot avoids the existing legacy uat-api.hi5central.com gateway.
SANDBOX_ROUTE_CHANNEL=parallel
API_URL=https://pilot-uat-api.hi5central.com
MARKETING_URL=https://hi5central.com
POSTGRES_USER=REPLACE_UNIQUE_POSTGRES_USER
POSTGRES_DB=REPLACE_UNIQUE_POSTGRES_DATABASE
POSTGRES_PASSWORD=REPLACE_HIGH_ENTROPY_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_HIGH_ENTROPY_REDIS_PASSWORD
MFA_ENCRYPTION_KEY=REPLACE_UNIQUE_HIGH_ENTROPY_MFA_KEY
# Passwords must be URL-encoded in the DSNs; hostnames are private Compose DNS.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_ENCODED_PASSWORD@postgres:5432/REPLACE_DATABASE
REDIS_URL=redis://:REPLACE_ENCODED_REDIS_PASSWORD@redis:6379/0
# Every image MUST reference an approved immutable OCI manifest digest.
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres@sha256:REPLACE_DIGEST
REDIS_IMAGE=public.ecr.aws/docker/library/redis@sha256:REPLACE_DIGEST
API_IMAGE=ghcr.io/dansut24/hi5central-platform-api@sha256:REPLACE_DIGEST
ITSM_IMAGE=ghcr.io/dansut24/hi5central-platform-itsm@sha256:REPLACE_DIGEST
