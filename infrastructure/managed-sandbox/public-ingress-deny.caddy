# Place this fragment FIRST INSIDE the existing public
# *.hi5central.com { ... } site block, BEFORE all @managed*
# and @tenant* handle directives and generic fallback proxy routes.
# Do not place this in generic customer self-hosted gateways.
#
# Explicit legacy uat.hi5central.com, test.hi5central.com,
# uat-api, test-api, test-rmm and test-admin remain outside the match.
# Mixed-case host headers are handled with (?i).
#
# Use "handle @unapprovedSandbox", not a top-level respond:
# top-level respond runs AFTER existing handle directives in this
# Caddyfile adapter and would not prevent Production ITSM fallback.
# CEL regular expressions use [.] for literal dots; the separate
# unmatched HTTPS site handles trailing-dot virtual host mismatches.
@unapprovedSandbox expression {http.request.host}.matches('(?i)^(?:[a-z0-9-]+(?:uat|test)(?:-(?:api|portal|rmm|admin|downloads|connect|turn))?|pilot-[a-z0-9-]+)[.]hi5central[.]com[.]*$')
handle @unapprovedSandbox {
    respond "Not Found" 404
}
