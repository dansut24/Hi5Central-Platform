# PILOT CONTROL PLANE ONLY. Never connect to live/dev/legacy databases.
# Copy into an operator-private directory, replace all secrets and chmod 0600.
COMPOSE_PROJECT_NAME=hi5central-pilot-control
DEPLOYMENT_MODE=managed
TENANCY_MODE=multi
RUNTIME_ENVIRONMENT=live
FEATURE_MODE=controlled
PLATFORM_ADMIN_MFA_REQUIRED=true
PILOT_ADMIN_BOOTSTRAP_ENABLED=true
BACKGROUND_WORKERS_ENABLED=false
ROOT_DOMAIN=hi5central.com
PRIMARY_TENANT_SLUG=
COOKIE_DOMAIN=
APP_URL=
PORTAL_URL=
RMM_URL=
TURN_URL=
ADMIN_URL=https://pilot-admin.hi5central.com
API_URL=https://pilot-control-api.hi5central.com
MARKETING_URL=https://hi5central.com
POSTGRES_USER=REPLACE_PILOT_UNIQUE_DB_USER
POSTGRES_DB=REPLACE_PILOT_UNIQUE_DB_NAME
POSTGRES_PASSWORD=REPLACE_HIGH_ENTROPY_DB_PASSWORD
REDIS_PASSWORD=REPLACE_HIGH_ENTROPY_REDIS_PASSWORD
DATABASE_URL=postgresql://REPLACE_PILOT_UNIQUE_DB_USER:REPLACE_URL_ENCODED_PASSWORD@postgres:5432/REPLACE_PILOT_UNIQUE_DB_NAME
REDIS_URL=redis://:REPLACE_URL_ENCODED_REDIS_PASSWORD@redis:6379/0
MFA_ENCRYPTION_KEY=REPLACE_RANDOM_PILOT_ONLY_MFA_ENCRYPTION_KEY
CONNECT_CODE_HMAC_KEY=REPLACE_RANDOM_PILOT_ONLY_CONNECT_HMAC_KEY
# Use separate, reviewed OCI digests. Never use :dev or mutable tags.
POSTGRES_IMAGE=mirror.gcr.io/library/postgres@sha256:REPLACE_DIGEST
REDIS_IMAGE=mirror.gcr.io/library/redis@sha256:REPLACE_DIGEST
API_IMAGE=ghcr.io/dansut24/hi5central-platform-api@sha256:REPLACE_DIGEST
ADMIN_IMAGE=ghcr.io/dansut24/hi5central-platform-admin@sha256:REPLACE_DIGEST
# Keep external email disabled until separately scoped relay and verified
# first-admin MFA/invitation onboarding are available.
