# Proposed public gateway additions — NOT an applied configuration.
# Requires explicit operator change approval and an independently reviewed
# restricted relay attached ONLY to the existing preview-gateway bridge
# and the isolated pilot-edge bridge (never pilot_data or Production DB).
pilot-admin.hi5central.com {
    encode zstd gzip
    reverse_proxy hi5central-pilot-auth-relay:8080

    tls {
        dns ionos {env.IONOS_API_TOKEN}
    }

    header {
        Cache-Control "no-store"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
}

pilot-control-api.hi5central.com {
    encode zstd gzip
    # The internal relay is an explicit allowlist; never expose its entire
    # upstream pilot API, DB, Redis, customer provisioning or agent routes.
    reverse_proxy hi5central-pilot-auth-relay:8081

    tls {
        dns ionos {env.IONOS_API_TOKEN}
    }

    header {
        Cache-Control "no-store"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
}
