# Hi5Central local development only.
# scripts/start-dev.ps1 automatically detects the PC LAN address and overrides DEV_HOST.
COMPOSE_PROJECT_NAME=hi5central-local
DEV_HOST=localhost

POSTGRES_DB=hi5central
POSTGRES_USER=hi5central
POSTGRES_PASSWORD=hi5central-local-only

PRIMARY_TENANT_SLUG=local
BACKGROUND_WORKERS_ENABLED=false
MFA_ENCRYPTION_KEY=

SMTP_USER=local
SMTP_PASSWORD=local
