{
  "manifest_version": 3,
  "name": "Hi5Central EPM — Download approvals (Newtest)",
  "version": "0.1.0",
  "description": "Request technician approval for signed Windows EXE downloads. Never bypasses native UAC.",
  "key": "",
  "permissions": [
    "downloads",
    "notifications",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Hi5Central: Request elevation for latest EXE"
  },
  "icons": {
    "128": "icon-128.png"
  }
}
