:80 {
  handle /healthz {
    respond "ok" 200
  }

  @runtimeConfig path /runtime-config.js
  handle @runtimeConfig {
    header Cache-Control "no-store, no-cache, must-revalidate"
    header Pragma "no-cache"
    header Expires "0"
    root * /srv
    file_server
  }

  handle {
    # Login/session navigation must never keep an obsolete SPA bootstrap in
    # Safari after the central identity fix or a future deployment.
    @htmlNavigation header Accept *text/html*
    header @htmlNavigation Cache-Control "no-store, max-age=0"
    encode zstd gzip
    root * /srv
    try_files {path} /index.html
    file_server

    header {
      X-Content-Type-Options "nosniff"
      Referrer-Policy "strict-origin-when-cross-origin"
      X-Frame-Options "SAMEORIGIN"
      -Server
    }
  }
}
